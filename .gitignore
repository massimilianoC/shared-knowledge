# =============================================================================
# .gitignore — Shared Knowledge Repository
# A documentation/knowledge repo: ignore editor cruft, OS noise, ephemeral
# tooling. Source-of-truth content (skills/, agents/, knowledge/, MAP.md, etc.)
# is always committed.
# =============================================================================

# ---------------------------------------------------------------------------
# Operating systems
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.iml
*.iws
.fleet/
.cursor/
.zed/
.history/
*.swp
*.swo
*~
.project
.classpath
.settings/

# JetBrains shelved changes, workspace, etc.
.idea_modules/
out/

# ---------------------------------------------------------------------------
# Claude Code / AI assistant local state
# ---------------------------------------------------------------------------
.claude/
.claude.json
.claude-cache/
.continue/
.windsurf/
.aider*
.codex/
.gemini/
.copilot/

# Local override / private project context
CLAUDE.local.md
AGENTS.local.md
.env
.env.*
!.env.example

# Private ingestion and repository-maintenance material
/inbox/
/AGENTS.md
/AI_GUIDELINES.md
/CLAUDE.md
/CONTRIBUTING.md
/.cursorrules
/.windsurfrules
/.github/copilot-instructions.md

# ---------------------------------------------------------------------------
# Python (in case helper scripts appear during processing)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ---------------------------------------------------------------------------
# Node (in case tooling is added later)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log
.pnp.*

# ---------------------------------------------------------------------------
# Build / coverage / logs
# ---------------------------------------------------------------------------
dist/
build/
*.log
*.tmp
*.bak
coverage/
.nyc_output/
.tox/
.cache/

# ---------------------------------------------------------------------------
# One-shot scripts and scratch artifacts
# ---------------------------------------------------------------------------
# One-shot reorganization or migration scripts left around accidentally
_reorg.py
_scratch/
scratch/
TODO.local.md
NOTES.local.md
*.draft.md
*.scratch.md

# ---------------------------------------------------------------------------
# Generated documentation artifacts (regenerated on demand)
# ---------------------------------------------------------------------------
_site/
.docusaurus/

# ---------------------------------------------------------------------------
# Archives / OS-specific binaries that should never be committed
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.exe
*.dll
*.so
*.dylib
